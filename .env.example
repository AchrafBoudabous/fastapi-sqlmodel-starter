# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="FastAPI SQLModel Starter"
APP_VERSION="0.1.0"
# Set to true for local development (enables SQL query logging, relaxes SECRET_KEY check).
# Must be false in production.
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (Postgres running on the host):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# When using docker-compose the app container overrides this automatically
# to use the 'db' service hostname — you don't need to change it here.

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# REQUIRED in production (DEBUG=false): replace with a real random secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. In production, list only your actual frontend origins.
# Example: CORS_ORIGINS='["https://app.example.com","https://www.example.com"]'
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'
